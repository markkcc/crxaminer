<%# Site header: logo linking home (unless logo: false) and the main navigation. %>
<% show_logo = local_assigns.fetch(:logo, true) %>
<header class="w-full">
  <% if show_logo %>
    <div class="flex justify-center mb-2">
      <%= link_to root_path, class: "block w-full max-w-[350px] rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500" do %>
        <%= render "shared/logo" %>
      <% end %>
    </div>
  <% end %>

  <nav aria-label="Main" class="w-full py-2 mb-2">
    <ul class="flex flex-wrap justify-center gap-x-4 gap-y-1">
      <% [
           ["[ new scan ]", root_path, current_page?(root_path)],
           ["[ statistics ]", stats_scan_index_path, current_page?(stats_scan_index_path)],
           ["[ github ]", "https://github.com/markkcc/crxaminer", false],
           ["[ twitter ]", "https://x.com/CRXaminer", false],
           ["[ help ]", "https://astarte.security/docs/tools/crxaminer", false]
         ].each do |label, href, current| %>
        <li class="whitespace-nowrap">
          <% if current %>
            <%= link_to label, href, aria: { current: "page" },
                class: "font-semibold text-brand-700 dark:text-brand-200 hover:text-brand-600 dark:hover:text-brand-300" %>
          <% elsif href.start_with?("http") %>
            <%= link_to label, href, target: "_blank", rel: "noopener",
                class: "text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-300" %>
          <% else %>
            <%= link_to label, href,
                class: "text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-300" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
</header>
