<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><% if content_for?(:title) %><%= yield(:title) %> · CRXaminer<% else %>CRXaminer: Chrome extension security scanner<% end %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Scan a Chrome extension's manifest and get a security risk verdict: permissions, host access, embedded URLs and more.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= favicon_link_tag 'favicon.svg' %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <!-- Basic Open Graph tags -->
    <meta property="og:title" content="CRXaminer">
    <meta property="og:description" content="Web application for examining Chrome extensions and identifying potential security issues">
    <meta property="og:image" content="<%= image_url('crx-title-cover.jpg') %>">
    <meta property="og:url" content="<%= request.original_url %>">
    
    <!-- Optional but recommended -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="CRXaminer">
    
    <!-- Twitter Card tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="<%= image_url('crx-title-cover.jpg') %>">
  </head>

  <%# A column at least as tall as the window: the site notice, then the page, which fills
      the rest (pages use flex-1, not min-h-screen, so the notice adds no scrollbar). %>
  <body class="min-h-full flex flex-col bg-gray-100 dark:bg-gray-900">
    <%= render "shared/upgrade_notice" %>
    <%= yield %>
    <%= yield :page_scripts %>
  </body>
</html>
