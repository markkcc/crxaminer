<% content_for :title, "Statistics" %>
<div class="flex-1 flex flex-col bg-gray-50 dark:bg-gray-900">
  <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow overflow-y-auto">
    <%= render "shared/header" %>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-6">
      <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-700 dark:text-gray-200 mb-6">
          Statistics Dashboard
        </h1>

        <%# The cards. Each is built on its own (stat_card), from numbers saved in the
            background (ScanStats): one that is missing or cannot be shown is left out
            and the others still appear. %>
        <% if @stats.empty? %>
          <p class="mb-6 text-sm text-gray-600 dark:text-gray-400" id="stats-pending">
            The statistics are being worked out. Check back in a few minutes.
          </p>
        <% end %>

        <%= stat_tiles(
              stat_card(:total) { render "scan/stats/tile", key: "total", title: "Unique ext. scanned", value: @total_scans },
              stat_card(:recent) { render "scan/stats/tile", key: "recent", title: "Scans in last 30 days", value: @stats.scans_last_30_days || 0 },
              stat_card(:all_sites) do
                if (all_sites = @stats.all_sites)
                  render "scan/stats/tile", key: "all-sites", title: "Can run on every site", value: all_sites.count, notes: [
                    "#{stat_percent(all_sites.count, all_sites.scans)} of scanned extensions",
                    ("Host access: #{number_with_delimiter(all_sites.host_access)} · Content scripts: #{number_with_delimiter(all_sites.content_scripts)}" if all_sites.host_access && all_sites.content_scripts)
                  ]
                elsif (all_urls = @stats.all_urls_count)
                  # The older, narrower count, until the newer one has been worked out.
                  render "scan/stats/tile", key: "all-urls", title: "Ext. with <all_urls>", value: all_urls
                end
              end,
              stat_card(:manifest_versions) do
                if (versions = @stats.manifest_versions)
                  render "scan/stats/tile", key: "manifest-v2", title: "Still on Manifest V2", value: versions.v2, notes: [
                    "#{stat_percent(versions.v2, versions.total)} of scanned extensions",
                    "Manifest V3: #{number_with_delimiter(versions.v3)}"
                  ]
                end
              end
            ) %>

        <%= stat_row(
              stat_card(:popular_full_control) do
                if (popular = @stats.popular_full_control)
                  render "scan/stats/extensions", key: "popular-full-control", title: "Most installed with full-control access",
                         caption: "Extensions in the Full control access tier, by number of users.", extensions: popular, unit: "user"
                end
              end,
              stat_card(:users) { (users = @stats.users) && render("scan/stats/users", users: users) }
            ) %>

        <%= stat_row(
              stat_card(:permissions) { (permissions = @stats.permissions) && render("scan/stats/permissions", permissions: permissions) }
            ) %>

        <%= stat_row(
              stat_card(:spiciest) do
                spiciest = @stats.spiciest
                render "scan/stats/extensions", key: "spiciest", title: "Top 5 spiciest", extensions: spiciest, unit: "finding" if spiciest.any?
              end,
              stat_card(:ratings) { render "scan/stats/ratings", level_counts: @stats.level_counts }
            ) %>

        <% if @stats.refreshed_at %>
          <p class="-mt-2 text-xs text-gray-500 dark:text-gray-400" id="stats-updated">
            Statistics updated <time datetime="<%= @stats.refreshed_at.utc.iso8601 %>"><%= @stats.refreshed_at.utc.strftime("%Y-%m-%d %H:%M") %> UTC</time>.
          </p>
        <% end %>
      </div>

      <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
        <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Recent Scans</h2>
        
        <div class="overflow-x-auto w-full">
          <%# Fixed layout so long names truncate. On phones only the name and rating show;
              the name links to the scan, as the Actions column does on wider screens. %>
          <table class="w-full table-fixed">
            <thead class="bg-gray-50 dark:bg-gray-900">
              <tr>
                <th scope="col" class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider border-b-2 border-gray-300 dark:border-gray-600">
                  Extension
                </th>
                <th scope="col" class="w-36 sm:w-40 px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider border-b-2 border-gray-300 dark:border-gray-600">
                  Rating
                </th>
                <th scope="col" class="hidden sm:table-cell w-56 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider border-b-2 border-gray-300 dark:border-gray-600">
                  Scan Date
                </th>
                <th scope="col" class="hidden sm:table-cell w-36 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider border-b-2 border-gray-300 dark:border-gray-600">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody id="recent-scans-tbody" class="bg-white dark:bg-gray-800">
              <%= render partial: 'recent_scans_table', locals: { recent_scans: @recent_scans } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%= render "shared/footer" %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    let activeSeverity = null;
    const filterButtons = document.querySelectorAll('.severity-filter-btn');
    const tbody = document.getElementById('recent-scans-tbody');

    filterButtons.forEach(button => {
      button.addEventListener('click', function() {
        const severity = this.dataset.severity;

        // If clicking the same severity, deactivate filter
        if (activeSeverity === severity) {
          activeSeverity = null;
          // Remove active state from all buttons
          filterButtons.forEach(btn => {
            btn.classList.remove('ring-2', 'ring-brand-500', 'ring-offset-2', 'dark:ring-offset-gray-700', 'bg-brand-100', 'dark:bg-gray-600');
            btn.setAttribute('aria-pressed', 'false');
          });
          // Fetch all scans (no filter)
          fetchScans(null);
        } else {
          // Activate new filter
          activeSeverity = severity;

          // Update button states
          filterButtons.forEach(btn => {
            if (btn.dataset.severity === severity) {
              btn.classList.add('ring-2', 'ring-brand-500', 'ring-offset-2', 'dark:ring-offset-gray-700', 'bg-brand-100', 'dark:bg-gray-600');
              btn.setAttribute('aria-pressed', 'true');
            } else {
              btn.classList.remove('ring-2', 'ring-brand-500', 'ring-offset-2', 'dark:ring-offset-gray-700', 'bg-brand-100', 'dark:bg-gray-600');
              btn.setAttribute('aria-pressed', 'false');
            }
          });

          // Fetch filtered scans
          fetchScans(severity);
        }
      });
    });

    function fetchScans(severity) {
      const url = new URL(window.location.href);
      if (severity) {
        url.searchParams.set('severity', severity);
      } else {
        url.searchParams.delete('severity');
      }

      fetch(url, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => response.text())
      .then(html => {
        tbody.innerHTML = html;
      })
      .catch(error => {
        console.error('Error fetching scans:', error);
      });
    }
  });
</script>