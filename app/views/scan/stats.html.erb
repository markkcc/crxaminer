<% content_for :title, "Statistics" %>
<div class="min-h-screen flex flex-col bg-gray-50 dark:bg-gray-900">
  <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow overflow-y-auto">
    <%= render "shared/header" %>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-6">
      <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-700 dark:text-gray-200 mb-6">
          Statistics Dashboard
        </h1>

        <!-- Metrics Dashboard -->
        <!-- Top Metrics Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
          <!-- Unique Extensions Scanned -->
          <div class="bg-brand-50 dark:bg-gray-700 rounded-lg p-6 border border-brand-200 dark:border-gray-600">
            <h2 class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">Unique ext. scanned</h2>
            <p class="text-4xl font-bold text-brand-700 dark:text-brand-200"><%= number_with_delimiter(@total_scans) %></p>
          </div>

          <!-- Scans Last 30 Days -->
          <div class="bg-brand-50 dark:bg-gray-700 rounded-lg p-6 border border-brand-200 dark:border-gray-600">
            <h2 class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">Scans in last 30 days</h2>
            <p class="text-4xl font-bold text-brand-700 dark:text-brand-200"><%= number_with_delimiter(@scans_last_30_days) %></p>
          </div>

          <!-- Extensions with <all_urls> -->
          <div class="bg-brand-50 dark:bg-gray-700 rounded-lg p-6 border border-brand-200 dark:border-gray-600">
            <h2 class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">Ext. with &lt;all_urls&gt;</h2>
            <p class="text-4xl font-bold text-brand-700 dark:text-brand-200"><%= number_with_delimiter(@all_urls_count) %></p>
          </div>
        </div>

        <!-- Bottom Tables Row -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
          <!-- Top 5 Spiciest Card -->
          <div class="bg-brand-50 dark:bg-gray-700 rounded-lg p-6 border border-brand-200 dark:border-gray-600">
            <h2 class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-4">Top 5 spiciest</h2>
            <div class="space-y-3">
              <% @spiciest_extensions.each do |ext_data| %>
                <% scan = ext_data[:scan] %>
                <%= link_to scan_path(scan.extension_id), class: "flex items-center justify-between p-2 hover:bg-brand-100 dark:hover:bg-gray-600 rounded transition-colors" do %>
                  <div class="flex items-center space-x-3 min-w-0 flex-1">
                    <% if scan.extension_image.present? %>
                      <img src="<%= scan.extension_image %>" alt="<%= scan.extension_name %>" class="w-8 h-8 rounded flex-shrink-0">
                    <% else %>
                      <div class="w-8 h-8 bg-gray-300 dark:bg-gray-600 rounded flex-shrink-0"></div>
                    <% end %>
                    <span class="text-sm text-gray-700 dark:text-gray-200 truncate"><%= scan.extension_name || "Unknown Extension" %></span>
                  </div>
                  <span class="text-sm font-semibold text-brand-700 dark:text-brand-200 ml-2 flex-shrink-0"><%= ext_data[:finding_count] %> findings</span>
                <% end %>
              <% end %>
            </div>
          </div>

          <!-- Overall rating distribution card -->
          <div class="bg-brand-50 dark:bg-gray-700 rounded-lg p-6 border border-brand-200 dark:border-gray-600">
            <h2 class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-1">Overall ratings</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">Select a level to list its recent scans.</p>
            <% total_count = @severity_counts.values.sum %>
            <div class="space-y-1" role="group" aria-label="Filter recent scans by overall rating">
              <% @severity_counts.each do |severity, count| %>
                <% percentage = total_count > 0 ? (count.to_f / total_count * 100).round : 0 %>
                <button type="button"
                        class="severity-filter-btn block w-full text-left p-2 hover:bg-brand-100 dark:hover:bg-gray-600 rounded transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 dark:focus-visible:ring-brand-300"
                        data-severity="<%= severity %>"
                        aria-pressed="false">
                  <span class="flex items-center justify-between gap-3 mb-1.5">
                    <%= overall_badge(severity, size: :sm) %>
                    <span class="flex items-baseline gap-2 tabular-nums">
                      <span class="text-xs text-gray-600 dark:text-gray-400"><%= percentage %>%</span>
                      <span class="text-sm font-semibold text-brand-700 dark:text-brand-200"><%= number_with_delimiter(count) %></span>
                    </span>
                  </span>
                  <span class="block w-full bg-gray-200 dark:bg-gray-600 rounded-full h-2 relative" aria-hidden="true">
                    <span class="block <%= severity_classes(severity) %> h-2 rounded-full" style="width: <%= percentage %>%;"></span>
                  </span>
                </button>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      
      <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
        <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Recent Scans</h2>
        
        <div class="overflow-x-auto w-full">
          <%# Fixed layout so long names truncate. On phones only the name and rating show;
              the name links to the scan, as the Actions column does on wider screens. %>
          <table class="w-full table-fixed">
            <thead class="bg-gray-50 dark:bg-gray-900">
              <tr>
                <th scope="col" class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider border-b-2 border-gray-300 dark:border-gray-600">
                  Extension
                </th>
                <th scope="col" class="w-36 sm:w-40 px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider border-b-2 border-gray-300 dark:border-gray-600">
                  Rating
                </th>
                <th scope="col" class="hidden sm:table-cell w-56 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider border-b-2 border-gray-300 dark:border-gray-600">
                  Scan Date
                </th>
                <th scope="col" class="hidden sm:table-cell w-36 px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider border-b-2 border-gray-300 dark:border-gray-600">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody id="recent-scans-tbody" class="bg-white dark:bg-gray-800">
              <%= render partial: 'recent_scans_table', locals: { recent_scans: @recent_scans } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%= render "shared/footer" %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    let activeSeverity = null;
    const filterButtons = document.querySelectorAll('.severity-filter-btn');
    const tbody = document.getElementById('recent-scans-tbody');

    filterButtons.forEach(button => {
      button.addEventListener('click', function() {
        const severity = this.dataset.severity;

        // If clicking the same severity, deactivate filter
        if (activeSeverity === severity) {
          activeSeverity = null;
          // Remove active state from all buttons
          filterButtons.forEach(btn => {
            btn.classList.remove('ring-2', 'ring-brand-500', 'ring-offset-2', 'dark:ring-offset-gray-700', 'bg-brand-100', 'dark:bg-gray-600');
            btn.setAttribute('aria-pressed', 'false');
          });
          // Fetch all scans (no filter)
          fetchScans(null);
        } else {
          // Activate new filter
          activeSeverity = severity;

          // Update button states
          filterButtons.forEach(btn => {
            if (btn.dataset.severity === severity) {
              btn.classList.add('ring-2', 'ring-brand-500', 'ring-offset-2', 'dark:ring-offset-gray-700', 'bg-brand-100', 'dark:bg-gray-600');
              btn.setAttribute('aria-pressed', 'true');
            } else {
              btn.classList.remove('ring-2', 'ring-brand-500', 'ring-offset-2', 'dark:ring-offset-gray-700', 'bg-brand-100', 'dark:bg-gray-600');
              btn.setAttribute('aria-pressed', 'false');
            }
          });

          // Fetch filtered scans
          fetchScans(severity);
        }
      });
    });

    function fetchScans(severity) {
      const url = new URL(window.location.href);
      if (severity) {
        url.searchParams.set('severity', severity);
      } else {
        url.searchParams.delete('severity');
      }

      fetch(url, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => response.text())
      .then(html => {
        tbody.innerHTML = html;
      })
      .catch(error => {
        console.error('Error fetching scans:', error);
      });
    }
  });
</script>