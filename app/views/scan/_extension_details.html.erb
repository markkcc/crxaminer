<%# "Extension Details" in the header card: what the Chrome Web Store listing said
    (ExtensionDetailsHelper). Short facts are evenly sized tiles that flow into as many
    columns as fit; the store badges are the last tile. The developer's contact details
    sit below in a calmer panel, split into their parts when the text has the store's
    usual "; " form. All of it is untrusted text: escaped, never a link. %>
<% details = local_assigns[:details] %>
<% facts = extension_facts(details) %>
<% badges = extension_store_badges(details) %>
<% contact = developer_info_parts(details) %>
<% label_class = "text-xs font-medium text-gray-500 dark:text-gray-400" %>
<section class="border-t border-gray-200 dark:border-gray-700 pt-4" aria-labelledby="extension-details-heading" id="extension-details">
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 mb-3">
    <h2 id="extension-details-heading" class="text-lg font-semibold text-gray-700 dark:text-gray-200">Extension Details</h2>
    <p class="text-xs text-gray-500 dark:text-gray-400">From the Chrome Web Store listing</p>
  </div>

  <% if facts.empty? && badges.empty? && contact.nil? %>
    <p class="text-sm text-gray-500 dark:text-gray-400" data-details-empty>No listing details were saved with this scan.</p>
  <% else %>
    <% if facts.any? || badges.any? %>
      <dl class="grid grid-cols-2 sm:grid-cols-[repeat(auto-fill,minmax(10.5rem,1fr))] gap-2 sm:gap-3" id="extension-facts">
        <% facts.each do |fact| %>
          <div class="min-w-0 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2.5 dark:border-gray-700 dark:bg-gray-900/40" data-fact="<%= fact.key %>">
            <dt class="<%= label_class %>"><%= fact.label %></dt>
            <dd class="mt-0.5 font-semibold text-gray-800 dark:text-gray-100 [overflow-wrap:anywhere]">
              <%= fact.value %><% if fact.key == :rating && star_rating?(fact.value) %><span class="sr-only"> out of 5</span><svg class="inline-block w-3.5 h-3.5 ml-1 -mt-0.5 text-amber-500 dark:text-amber-400" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 1.5l1.95 4.1 4.5.55-3.3 3.1.85 4.45L8 11.5l-4 2.2.85-4.45-3.3-3.1 4.5-.55z"/></svg><% end %>
            </dd>
            <% if fact.note %>
              <dd class="text-xs text-gray-500 dark:text-gray-400 [overflow-wrap:anywhere]"><%= fact.note %></dd>
            <% end %>
          </div>
        <% end %>
        <% if badges.any? %>
          <div class="min-w-0 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2.5 dark:border-gray-700 dark:bg-gray-900/40" data-fact="badges" data-store-badges>
            <dt class="<%= label_class %>">Store badges</dt>
            <% badges.each do |badge| %>
              <dd class="mt-1 mr-1 inline-flex items-center gap-1 rounded-full border border-brand-200 bg-brand-50 px-2 py-0.5 text-xs font-semibold text-brand-800 dark:border-brand-700 dark:bg-brand-900/60 dark:text-brand-100" data-store-badge>
                <svg class="w-3 h-3 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="8" cy="6.25" r="4.25"/><path d="m5.6 9.8-1 4.7L8 12.8l3.4 1.7-1-4.7"/></svg><%= badge %>
              </dd>
            <% end %>
          </div>
        <% end %>
      </dl>
    <% end %>

    <% if contact %>
      <% address = contact.reject(&:first).map(&:last) %>
      <% labelled = contact.select(&:first) %>
      <div class="<%= "mt-3 " if facts.any? || badges.any? %>rounded-lg border border-dashed border-gray-300 px-3 py-2.5 text-sm text-gray-600 dark:border-gray-600 dark:text-gray-300" id="developer-info">
        <p class="<%= label_class %>">Developer contact</p>
        <% address.each do |line| %>
          <p class="mt-1 text-gray-700 dark:text-gray-200 [overflow-wrap:anywhere]" data-contact-text><%= line %></p>
        <% end %>
        <% if labelled.any? %>
          <%# Phones: a two-column list, labels aligned. Wider: the parts flow on one line. %>
          <dl class="mt-1.5 grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 sm:flex sm:flex-wrap sm:gap-x-6">
            <% labelled.each do |label, value| %>
              <div class="contents sm:flex sm:min-w-0 sm:max-w-full sm:gap-1.5" data-contact-part>
                <dt class="shrink-0 text-gray-500 dark:text-gray-400"><%= label %></dt>
                <dd class="min-w-0 text-gray-800 dark:text-gray-100 [overflow-wrap:anywhere]"><%= value %></dd>
              </div>
            <% end %>
          </dl>
        <% end %>
      </div>
    <% end %>
  <% end %>
</section>
