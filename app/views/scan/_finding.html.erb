<%# One rule finding (id finding-N, linked from the rating card), with a control that opens the manifest lines it came from and
    points out its note there (data-manifest-finding matches the note's data-note-for). %>
<% lines = @report.finding_lines(finding) %>
<%= tag.li class: "border dark:border-gray-700 rounded-lg p-3 scroll-mt-24", id: "finding-#{@report.manifest_notes.ref_for(finding)}", data: { finding: "" } do %>
  <div class="flex items-start gap-2">
    <% if finding.severity.present? %>
      <span class="shrink-0 max-w-[50%]"><%= finding_badge(finding.severity) %></span>
    <% end %>
    <div class="font-medium text-gray-700 dark:text-gray-200 text-sm leading-[22px] min-w-0 break-words">
      <%= finding.title.presence || "Untitled finding" %>
    </div>
  </div>
  <div class="text-gray-600 dark:text-gray-300 text-sm mt-1 break-words">
    <%= finding.description %>
  </div>
  <% if lines.any? %>
    <button type="button"
            class="mt-2 text-xs font-medium text-brand-700 hover:text-brand-800 dark:text-brand-300 dark:hover:text-brand-200 underline rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
            data-manifest-lines="<%= lines.join(" ") %>"
            data-manifest-finding="<%= @report.manifest_notes.ref_for(finding) %>">
      <% if lines.size == 1 %>Show line <%= lines.first %><% elsif lines.size <= 3 %>Show lines <%= lines.to_sentence %><% else %>Show the <%= lines.size %> lines<% end %> in the manifest
    </button>
  <% end %>
<% end %>
