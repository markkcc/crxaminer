<!-- Security findings section -->
  <% if @security_findings&.any? %>
    <!-- Context-Aware Verdict section (falls back to the rule-based rating when no AI analysis exists) -->
    <% ai_analysis = @security_findings.find { |f| f[:severity] == "Info" && f[:title] == "AI Context Analysis" } %>
    <% overall_finding = @security_findings.find { |f| f[:title]&.downcase&.include?('overall risk') } %>
    <% ai_data = ai_analysis && ai_analysis[:ai].is_a?(Hash) ? ai_analysis[:ai] : nil %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-6">
      <div class="flex items-center gap-4 mb-4 relative">
        <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-200"><%= ai_analysis ? "Context-Aware Verdict" : "Rule-based rating" %></h2>
        <button type="button"
                class="text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200 text-xl leading-none rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
                data-popover-target="info-popup"
                aria-controls="info-popup"
                aria-expanded="false"
                aria-label="About this rating">
          <span aria-hidden="true">ⓘ</span>
        </button>
        <div id="info-popup"
             class="hidden absolute left-0 top-full mt-2 z-50 w-full max-w-md bg-white dark:bg-gray-700 border border-brand-200 dark:border-gray-600 shadow-lg p-4 rounded-lg text-brand-700 dark:text-brand-200 text-sm">
          <% if ai_analysis %>
            This section provides a Claude-based AI analysis that applies additional context to the risk. Results are not guaranteed to be accurate.
          <% else %>
            This rating comes only from CRXaminer's rule-based checks of the manifest. AI context is unavailable for this scan.
          <% end %>
        </div>
      </div>

      <div class="space-y-3 text-gray-600 dark:text-gray-300">
        <% if ai_data %>
          <% risk_level = ai_data[:risk_level].to_s %>
          <div class="<%= severity_classes(risk_level) %> rounded-lg p-3 mb-3">
            <div class="flex items-center gap-2">
              <div class="font-semibold text-sm">
                <%= risk_level.upcase %>
              </div>
              <div class="font-medium text-sm">
                Overall Risk
              </div>
            </div>
          </div>
          <% if ai_data[:summary].present? %>
            <p><%= ai_data[:summary] %></p>
          <% end %>
          <% [["Trust Factors", :trust_factors], ["Concerns", :concerns], ["Recommendations", :recommendations]].each do |heading, key| %>
            <% items = Array(ai_data[key]) %>
            <% next if items.empty? %>
            <div class="font-medium text-gray-700 dark:text-gray-200 mt-4 mb-2">
              <%= heading %>
            </div>
            <ul class="ml-4 text-sm list-disc list-inside space-y-1">
              <% items.each do |item| %>
                <li><%= item %></li>
              <% end %>
            </ul>
          <% end %>
          <% analyzed_at = (Time.zone.parse(ai_data[:analyzed_at].to_s) rescue nil) %>
          <div class="text-xs text-gray-500 dark:text-gray-400 mt-4">
            AI analysis by <%= ai_data[:model].presence || "unknown model" %><% if analyzed_at %> on <%= analyzed_at.utc.strftime("%Y-%m-%d %H:%M UTC") %><% end %>
          </div>
        <% elsif ai_analysis %>
          <% ai_analysis[:description].to_s.split("\n").each_with_index do |line, index| %>
            <% if index == 0 && line.start_with?("Risk Level:") %>
              <% risk_level = line.split("Risk Level:").last.strip %>
              <div class="<%= severity_classes(risk_level) %> rounded-lg p-3 mb-3">
                <div class="flex items-center gap-2">
                  <div class="font-semibold text-sm">
                    <%= risk_level.upcase %>
                  </div>
                  <div class="font-medium text-sm">
                    Overall Risk
                  </div>
                </div>
              </div>
            <% else %>
              <% if line.present? %>
                <% if line.start_with?("Trust Factors:", "Concerns:", "Recommendations:") %>
                  <div class="font-medium text-gray-700 dark:text-gray-200 mt-4 mb-2">
                    <%= line %>
                  </div>
                <% elsif line.start_with?("- ") %>
                  <div class="ml-4 text-sm">
                    <%= line %>
                  </div>
                <% else %>
                  <p><%= line %></p>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% else %>
          <% if overall_finding %>
            <div class="<%= severity_classes(overall_finding[:severity]) %> rounded-lg p-3">
              <div class="flex items-center gap-2">
                <div class="font-semibold text-sm">
                  <%= overall_finding[:severity]&.upcase %>
                </div>
                <div class="font-medium text-sm">
                  Overall Risk
                </div>
              </div>
              <div class="text-sm mt-1">
                <%= overall_finding[:description] %>
              </div>
            </div>
          <% end %>
          <p class="text-sm">AI context is unavailable for this scan. This rating is based on rule-based checks only.</p>
        <% end %>
      </div>
    </div>

    <!-- Findings section -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-6">
      <div class="flex items-center gap-4 mb-4 relative">
        <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-200">Findings</h2>
        <button type="button"
                class="text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200 text-xl leading-none rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
                data-popover-target="security-info-popup"
                aria-controls="security-info-popup"
                aria-expanded="false"
                aria-label="About the findings">
          <span aria-hidden="true">ⓘ</span>
        </button>
        <div id="security-info-popup"
             class="hidden absolute left-0 top-full mt-2 z-50 w-full max-w-md bg-white dark:bg-gray-700 border border-brand-200 dark:border-gray-600 shadow-lg p-4 rounded-lg text-brand-700 dark:text-brand-200 text-sm">
          This section provides a detailed analysis of the extension's security posture, without broader context. Assumes worst-case impact.
        </div>
      </div>

      <div class="space-y-3">
        <% # Sort and display findings, excluding AI analysis and overall risk %>
        <% other_findings = @security_findings
             .reject { |f| f[:title]&.downcase&.include?('overall risk') || (f[:severity] == "Info" && f[:title] == "AI Context Analysis") }
             .sort_by { |f| [ExtensionAnalyzerData::SEVERITY_ORDER.fetch(f[:severity]&.downcase, 999), f[:title]] } %>

        <% if other_findings.empty? %>
          <p class="text-sm text-gray-600 dark:text-gray-300" id="no-findings">
            No rule-based findings were raised for this extension.
          </p>
        <% end %>

        <% other_findings.each do |finding| %>
          <div class="border dark:border-gray-700 rounded-lg p-3">
            <div class="flex items-start gap-2">
              <div class="<%= severity_classes(finding[:severity]) %> shrink-0 px-2 py-0.5 rounded font-semibold text-sm">
                <%= finding[:severity]&.upcase %>
              </div>
              <div class="font-medium text-gray-700 dark:text-gray-200 text-sm">
                <%= finding[:title] %>
              </div>
            </div>
            <div class="text-gray-600 dark:text-gray-300 text-sm mt-1">
              <%= finding[:description] %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-200 mb-4">Findings</h2>
      <p class="text-sm text-gray-600 dark:text-gray-300" id="no-findings">
        No rule-based findings were raised for this extension.
      </p>
    </div>
  <% end %>

<script>
  // Info popovers: toggle on click, close on Escape or a click outside.
  (function() {
    const buttons = Array.from(document.querySelectorAll('[data-popover-target]'));

    function setOpen(button, open) {
      const popup = document.getElementById(button.dataset.popoverTarget);
      if (!popup) return;
      popup.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function closeAll(except) {
      buttons.forEach(button => { if (button !== except) setOpen(button, false); });
    }

    buttons.forEach(button => {
      button.addEventListener('click', function() {
        const open = this.getAttribute('aria-expanded') !== 'true';
        closeAll(this);
        setOpen(this, open);
      });
    });

    document.addEventListener('keydown', function(e) {
      if (e.key !== 'Escape') return;
      const openButton = buttons.find(button => button.getAttribute('aria-expanded') === 'true');
      if (!openButton) return;
      closeAll();
      openButton.focus();
    });

    document.addEventListener('click', function(e) {
      buttons.forEach(button => {
        const popup = document.getElementById(button.dataset.popoverTarget);
        if (button.contains(e.target) || (popup && popup.contains(e.target))) return;
        setOpen(button, false);
      });
    });
  })();
</script>
