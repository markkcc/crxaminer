<% if @manifest %>
  <% if @freshness %>
    <%= render "freshness", freshness: @freshness %>
  <% end %>

  <!-- Extension header section (keep this outside tabs) -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-6">
    <div class="flex items-center space-x-4 mb-4">
      <% if @extension_image %>
        <img src="<%= @extension_image %>" alt="Extension icon" class="w-16 h-16 rounded-lg shrink-0">
      <% end %>
      <div class="min-w-0">
        <h1 class="text-2xl font-bold text-gray-700 dark:text-gray-200 break-words">
          <%= @extension_name || "Unknown Extension" %>
        </h1>
        <% if @manifest[:version] %>
          <%# The store version is filled in by scan_page.js once known (or here from the cache). %>
          <div class="text-gray-600 dark:text-gray-300">
            <p>
              Version <%= @manifest[:version] %><% store_note = @freshness&.store_note %><% differs_class = "font-medium text-gray-800 dark:text-gray-100" %><% quiet_class = "text-sm text-gray-500 dark:text-gray-400" %><span
                class="<%= @freshness&.version_differs? ? differs_class : quiet_class %>"
                data-store-version-note data-differs-class="<%= differs_class %>" data-quiet-class="<%= quiet_class %>"><%= " · #{store_note}" if store_note %></span>

              <!-- Chrome Web Store link -->
              <% if @extension_id %>
                  <%= link_to "View in Chrome Web Store", 
                      "https://chrome.google.com/webstore/detail/#{@extension_id}", 
                      target: "_blank", 
                      class: "text-brand-600 hover:text-brand-700 dark:text-brand-300 dark:hover:text-brand-200 underline" %>
              <% end %>
            </p>
            <% if @last_scanned %>
              <p class="text-xs mt-2 text-gray-600 dark:text-gray-400">
                Last scanned: <%= time_ago_in_words(@last_scanned) %> ago
                <%# Shown when a re-scan is allowed: older than 24 hours, or the store has another version. %>
                <span data-rescan-link <%= "hidden" unless @freshness.nil? || @freshness.rescan_allowed? %>>
                  | <%= link_to "force re-scan", 
                        scan_path(@extension_id, force: true),
                        class: "text-brand-600 hover:text-brand-700 dark:text-brand-300 dark:hover:text-brand-200" %>
                </span>
              </p>
            <% end %>
          </div>
        <% end %>

      </div>
    </div>
    
    <div class="border-t border-gray-200 dark:border-gray-700 pt-4 mb-6">
      <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-3">Extension Details</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <% if @extension_details&.dig(:author).present? %>
          <div class="flex items-start">
            <span class="text-gray-500 dark:text-gray-400 w-32">Developer:</span>
            <span class="text-gray-700 dark:text-gray-200"><%= @extension_details[:author] %></span>
          </div>
        <% end %>
        
        <% if @extension_details&.dig(:rating).present? %>
          <div class="flex items-start">
            <span class="text-gray-500 dark:text-gray-400 w-32">Rating:</span>
            <span class="text-gray-700 dark:text-gray-200">
              <%= @extension_details[:rating] %> ★
              <% if @extension_details[:rating_count].present? %>
                (<%= @extension_details[:rating_count] %>)
              <% end %>
            </span>
          </div>
        <% end %>
        
        <% if @extension_details&.dig(:size).present? %>
          <div class="flex items-start">
            <span class="text-gray-500 dark:text-gray-400 w-32">Size:</span>
            <span class="text-gray-700 dark:text-gray-200"><%= @extension_details[:size] %></span>
          </div>
        <% end %>
        
        <% if @extension_details&.dig(:last_updated).present? %>
          <div class="flex items-start">
            <span class="text-gray-500 dark:text-gray-400 w-32">Last Updated:</span>
            <span class="text-gray-700 dark:text-gray-200"><%= @extension_details[:last_updated] %></span>
          </div>
        <% end %>

        <% if @extension_details&.dig(:users).present? %>
          <div class="flex items-start">
            <span class="text-gray-500 dark:text-gray-400 w-32">Users:</span>
            <span class="text-gray-700 dark:text-gray-200"><%= @extension_details[:users] %></span>
          </div>
        <% end %>
        
        <% if @extension_details&.dig(:developer_info).present? %>
          <div class="flex items-start md:col-span-2">
            <span class="text-gray-500 dark:text-gray-400 w-32">Developer Info:</span>
            <span class="text-gray-700 dark:text-gray-200 break-words max-w-[30ch]"><%= @extension_details[:developer_info] %></span>
          </div>
        <% end %>

      </div>
      <%# Store badges, recorded only when present (older scans have none). %>
      <% store_badges = { featured: "Featured", established_publisher: "Established publisher" }
                          .select { |key, _| @extension_details&.dig(key) == true }.values %>
      <% if store_badges.any? %>
        <p class="mt-3 text-xs text-gray-500 dark:text-gray-400" data-store-badges>
          Chrome Web Store badges: <%= store_badges.join(" · ") %>
        </p>
      <% end %>
    </div>
  </div>

  <%# Tabs. The active tab is kept in the URL hash (#overview, #permissions, #network, #manifest,
      #secure-annex); the older #analysis and #details still open Overview and Permissions.
      The two class lists are swapped whole by the page script, so no hover class is left behind. %>
  <% tabs = [
       ["overview", "Overview", nil],
       ["permissions", "Permissions", @report.permission_count],
       ["network", "Network", @report.network.domain_count],
       ["manifest", "Manifest", nil],
       ["secure-annex", "Secure Annex", nil]
     ] %>
  <div class="sticky top-0 z-30 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 py-2 mb-4 bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800">
    <%# relative: keeps the sr-only count brackets inside this scroller, not the page. %>
    <div class="relative -mx-1 overflow-x-auto">
      <div class="flex gap-2 p-1 w-max"
           role="tablist"
           aria-label="Scan results"
           id="scan-tabs"
           data-active-class="bg-brand-600 text-white hover:bg-brand-700"
           data-inactive-class="bg-gray-200 text-gray-700 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
           data-aliases="<%= { analysis: "overview", details: "permissions" }.to_json %>">
        <% tabs.each_with_index do |(id, label, count), index| %>
          <button class="shrink-0 whitespace-nowrap px-4 py-2 rounded-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900 <%= index.zero? ? "bg-brand-600 text-white hover:bg-brand-700" : "bg-gray-200 text-gray-700 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600" %>"
                  id="<%= id %>-tab"
                  data-tabs-target="<%= id %>"
                  type="button"
                  role="tab"
                  aria-controls="<%= id %>"
                  aria-selected="<%= index.zero? %>"
                  tabindex="<%= index.zero? ? 0 : -1 %>">
            <%= label %><% if count %><span class="sr-only"> (</span><span class="ml-2 inline-block min-w-6 px-1.5 rounded-full bg-white/80 text-gray-800 text-xs font-semibold tabular-nums align-middle" data-tab-count><%= number_with_delimiter(count) %></span><span class="sr-only">)</span><% end %>
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <%# Panels are focusable (tabindex 0) and get focus when opened from a link with a hash;
      they use the same focus ring as the other controls instead of the browser outline. %>
  <div id="tab-content">
    <div id="overview" class="block rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">
      <%= render "security_findings" %>
    </div>

    <div id="permissions" class="hidden rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900" role="tabpanel" aria-labelledby="permissions-tab" tabindex="0">
      <%= render "permissions" %>
    </div>

    <div id="network" class="hidden rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900" role="tabpanel" aria-labelledby="network-tab" tabindex="0">
      <%= render "network" %>
    </div>

    <div id="manifest" class="hidden rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900" role="tabpanel" aria-labelledby="manifest-tab" tabindex="0">
      <%= render "manifest" %>
    </div>

    <div id="secure-annex" class="hidden rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900" role="tabpanel" aria-labelledby="secure-annex-tab" tabindex="0">
      <%= render "secure_annex" %>
    </div>
  </div>
<% end %>
