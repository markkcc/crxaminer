<% if @manifest %>
  <!-- Extension header section (keep this outside tabs) -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-6">
    <div class="flex items-center space-x-4 mb-4">
      <% if @extension_image %>
        <img src="<%= @extension_image %>" alt="Extension icon" class="w-16 h-16 rounded-lg shrink-0">
      <% end %>
      <div class="min-w-0">
        <h1 class="text-2xl font-bold text-gray-700 dark:text-gray-200 break-words">
          <%= @extension_name || "Unknown Extension" %>
        </h1>
        <% if @manifest[:version] %>
          <p class="text-gray-600 dark:text-gray-300">
            Version <%= @manifest[:version] %>

            <!-- Chrome Web Store link -->
            <% if @extension_id %>
                <%= link_to "View in Chrome Web Store", 
                    "https://chrome.google.com/webstore/detail/#{@extension_id}", 
                    target: "_blank", 
                    class: "text-brand-600 hover:text-brand-700 dark:text-brand-300 dark:hover:text-brand-200 underline" %>
            <% end %>
            <% if @last_scanned %>
              <div class="text-xs mt-2 text-gray-600 dark:text-gray-400">
                Last scanned: <%= time_ago_in_words(@last_scanned) %> ago
                <% if @last_scanned < 24.hours.ago %>
                  | <%= link_to "force re-scan", 
                        scan_path(@extension_id, force: true),
                        class: "text-brand-600 hover:text-brand-700 dark:text-brand-300 dark:hover:text-brand-200" %>
                <% end %>
              </div>
            <% end %>
          </p>
        <% end %>

      </div>
    </div>
    
    <div class="border-t border-gray-200 dark:border-gray-700 pt-4 mb-6">
      <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-3">Extension Details</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <% if @extension_details&.dig(:author).present? %>
          <div class="flex items-start">
            <span class="text-gray-500 dark:text-gray-400 w-32">Developer:</span>
            <span class="text-gray-700 dark:text-gray-200"><%= @extension_details[:author] %></span>
          </div>
        <% end %>
        
        <% if @extension_details&.dig(:rating).present? %>
          <div class="flex items-start">
            <span class="text-gray-500 dark:text-gray-400 w-32">Rating:</span>
            <span class="text-gray-700 dark:text-gray-200">
              <%= @extension_details[:rating] %> ★
              <% if @extension_details[:rating_count].present? %>
                (<%= @extension_details[:rating_count] %>)
              <% end %>
            </span>
          </div>
        <% end %>
        
        <% if @extension_details[:size].present? %>
          <div class="flex items-start">
            <span class="text-gray-500 dark:text-gray-400 w-32">Size:</span>
            <span class="text-gray-700 dark:text-gray-200"><%= @extension_details[:size] %></span>
          </div>
        <% end %>
        
        <% if @extension_details[:last_updated].present? %>
          <div class="flex items-start">
            <span class="text-gray-500 dark:text-gray-400 w-32">Last Updated:</span>
            <span class="text-gray-700 dark:text-gray-200"><%= @extension_details[:last_updated] %></span>
          </div>
        <% end %>

        <% if @extension_details[:users].present? %>
          <div class="flex items-start">
            <span class="text-gray-500 dark:text-gray-400 w-32">Users:</span>
            <span class="text-gray-700 dark:text-gray-200"><%= @extension_details[:users] %></span>
          </div>
        <% end %>
        
        <% if @extension_details[:developer_info].present? %>
          <div class="flex items-start md:col-span-2">
            <span class="text-gray-500 dark:text-gray-400 w-32">Developer Info:</span>
            <span class="text-gray-700 dark:text-gray-200 break-words max-w-[30ch]"><%= @extension_details[:developer_info] %></span>
          </div>
        <% end %>

      </div>
    </div>
  </div>

  <!-- Tabs navigation. The active tab is kept in the URL hash (#analysis, #details, #manifest, #secure-annex). -->
  <%# The two class lists below are swapped whole by the script, so no hover class is left behind. %>
  <div class="mb-4 -mx-1 overflow-x-auto">
    <div class="flex gap-2 p-1 w-max"
         role="tablist"
         aria-label="Scan results"
         id="scan-tabs"
         data-active-class="bg-brand-600 text-white hover:bg-brand-700"
         data-inactive-class="bg-gray-200 text-gray-700 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600">
      <button class="shrink-0 whitespace-nowrap px-4 py-2 rounded-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900 bg-brand-600 text-white hover:bg-brand-700"
              id="analysis-tab"
              data-tabs-target="analysis"
              type="button"
              role="tab"
              aria-controls="analysis"
              aria-selected="true"
              tabindex="0">
        Analysis
      </button>
      <button class="shrink-0 whitespace-nowrap px-4 py-2 rounded-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900 bg-gray-200 text-gray-700 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
              id="details-tab"
              data-tabs-target="details"
              type="button"
              role="tab"
              aria-controls="details"
              aria-selected="false"
              tabindex="-1">
        Details
      </button>
      <button class="shrink-0 whitespace-nowrap px-4 py-2 rounded-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900 bg-gray-200 text-gray-700 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
              id="manifest-tab"
              data-tabs-target="manifest"
              type="button"
              role="tab"
              aria-controls="manifest"
              aria-selected="false"
              tabindex="-1">
        Raw Manifest
      </button>
      <button class="shrink-0 whitespace-nowrap px-4 py-2 rounded-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900 bg-gray-200 text-gray-700 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
              id="secure-annex-tab"
              data-tabs-target="secure-annex"
              type="button"
              role="tab"
              aria-controls="secure-annex"
              aria-selected="false"
              tabindex="-1">
        Secure Annex
      </button>
    </div>
  </div>

  <!-- Tab content -->
  <div id="tab-content">
    <!-- Analysis tab -->
    <div id="analysis" class="block" role="tabpanel" aria-labelledby="analysis-tab" tabindex="0">
      <%= render "security_findings" %>
    </div>

    <!-- Details tab -->
    <div id="details" class="hidden" role="tabpanel" aria-labelledby="details-tab" tabindex="0">
      <%= render "security_details" %>
    </div>

    <!-- Raw Manifest tab -->
    <div id="manifest" class="hidden" role="tabpanel" aria-labelledby="manifest-tab" tabindex="0">
      <%= render "manifest" %>
    </div>

    <!-- Secure Annex tab -->
    <div id="secure-annex" class="hidden" role="tabpanel" aria-labelledby="secure-annex-tab" tabindex="0">
      <%= render "secure_annex" %>
    </div>
  </div>
<% end %>

<%= javascript_tag do %>
  (function() {
    const tablist = document.getElementById('scan-tabs');
    if (!tablist) return;

    const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
    const activeClasses = tablist.dataset.activeClass.split(' ');
    const inactiveClasses = tablist.dataset.inactiveClass.split(' ');
    const TAB_IDS = ['analysis', 'details', 'manifest', 'secure-annex'];

    function tabFromHash() {
      const id = window.location.hash.slice(1);
      return TAB_IDS.includes(id) ? id : 'analysis';
    }

    function selectTab(targetId, options = {}) {
      tabs.forEach(tab => {
        const selected = tab.dataset.tabsTarget === targetId;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.setAttribute('tabindex', selected ? '0' : '-1');
        tab.classList.remove(...(selected ? inactiveClasses : activeClasses));
        tab.classList.add(...(selected ? activeClasses : inactiveClasses));

        const panel = document.getElementById(tab.dataset.tabsTarget);
        if (panel) {
          panel.classList.toggle('hidden', !selected);
          panel.classList.toggle('block', selected);
        }
        if (selected && options.focus) tab.focus();
      });

      // Record the tab in the URL without scrolling, so links and Back work.
      if (options.updateHash && tabFromHash() !== targetId) {
        history.pushState(null, '', '#' + targetId);
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', function() {
        selectTab(this.dataset.tabsTarget, { updateHash: true });
      });
    });

    tablist.addEventListener('keydown', function(e) {
      const current = tabs.indexOf(document.activeElement);
      if (current === -1) return;

      let next = null;
      if (e.key === 'ArrowRight') next = (current + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      if (next === null) return;

      e.preventDefault();
      selectTab(tabs[next].dataset.tabsTarget, { focus: true, updateHash: true });
      tabs[next].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    });

    window.addEventListener('popstate', () => selectTab(tabFromHash()));
    window.addEventListener('hashchange', () => selectTab(tabFromHash()));

    selectTab(tabFromHash());
  })();
<% end %>
