<% recent_scans.each do |scan| %>
  <% display_severity = get_display_severity(scan) %>
  <tr class="scan-row hover:bg-gray-50 dark:hover:bg-gray-700 border-t dark:border-gray-700" data-severity="<%= display_severity %>">
    <td class="px-3 sm:px-6 py-4">
      <div class="flex items-center">
        <div class="flex-shrink-0 w-10 sm:w-12">
          <% if scan.extension_image.present? %>
            <img src="<%= scan.extension_image %>" alt="Extension icon" class="w-10 h-10 rounded-lg">
          <% end %>
        </div>
        <div class="ml-3 sm:ml-4 flex-1 min-w-0">
          <%= link_to scan.extension_name.presence || "Unknown Extension", scan_path(scan.extension_id),
                class: "block text-sm font-medium text-gray-700 dark:text-gray-200 truncate hover:underline rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500" %>
          <div class="text-sm text-gray-500 dark:text-gray-400 mt-1 truncate">
            ID: <%= scan.extension_id %>
          </div>
        </div>
      </div>
    </td>
    <td class="px-3 sm:px-6 py-4">
      <%= overall_badge(display_severity, size: :sm) %>
    </td>
    <td class="hidden sm:table-cell px-6 py-4 text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">
      <time datetime="<%= scan.created_at.utc.iso8601 %>"><%= scan.created_at.utc.strftime("%Y-%m-%d %H:%M") %> UTC</time>
    </td>
    <td class="hidden sm:table-cell px-6 py-4 text-sm">
      <%= link_to "View Results", scan_path(scan.extension_id),
          class: "text-brand-600 hover:text-brand-800 dark:text-brand-300 dark:hover:text-brand-200 whitespace-nowrap" %>
    </td>
  </tr>
<% end %>
