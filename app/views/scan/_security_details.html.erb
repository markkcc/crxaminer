<div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-6">
<h2 class="text-xl font-semibold text-gray-700 dark:text-gray-200">Security Analysis Details</h2>
<div class="space-y-3 text-gray-600 dark:text-gray-300">
  <!-- Permissions List -->
  <% if @manifest %>
    <div class="mt-4">
      <div class="space-y-2">
        <% if @manifest[:permissions]&.any? %>
          <div>
            <h4 class="text-sm font-medium text-gray-600 dark:text-gray-400">Required Permissions:</h4>
            <ul class="list-disc list-inside ml-4 text-sm">
              <% @manifest[:permissions].each do |permission| %>
                <li><%= permission %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if @manifest[:optional_permissions]&.any? %>
          <div>
            <h4 class="text-sm font-medium text-gray-600 dark:text-gray-400">Optional Permissions:</h4>
            <ul class="list-disc list-inside ml-4 text-sm">
              <% @manifest[:optional_permissions].each do |permission| %>
                <li><%= permission %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if @manifest[:host_permissions]&.any? %>
          <div>
            <h4 class="text-sm font-medium text-gray-600 dark:text-gray-400">Host Permissions:</h4>
            <ul class="list-disc list-inside ml-4 text-sm">
              <% @manifest[:host_permissions].each do |permission| %>
                <li><%= permission %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if @manifest[:content_security_policy]&.any? %>
          <div>
            <h4 class="text-sm font-medium text-gray-600 dark:text-gray-400">Content Security Policy:</h4>
            <ul class="list-disc list-inside ml-4 text-sm">
              <% @manifest[:content_security_policy].each do |policy| %>
                <li><%= policy %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if @manifest[:embedded_urls]&.any? %>
          <div class="pt-4">
            <h4 class="text-sm font-medium text-gray-600 dark:text-gray-400">
              Embedded URLs (<%= @manifest[:embedded_urls].size %> total):
            </h4>
            <div class="mt-2 w-full">
              <%# Pages hold 20 URLs on phones and 80 from md up; the script sets the page size from the viewport.
                  Before it runs, CSS already shows only the first 20 on phones, so the list never shrinks visibly. %>
              <div id="embedded-urls-container" data-urls="<%= @manifest[:embedded_urls].to_json %>"
                   data-page-size-narrow="20" data-page-size-wide="80">
                <%# One column on phones, two from md up. URLs are plain text, never links. %>
                <ul id="embedded-urls-list"
                    class="grid grid-cols-1 md:grid-cols-2 md:gap-x-6"
                    data-item-class="px-3 py-2 border-t font-mono text-xs leading-5 break-all text-gray-700 dark:text-gray-300">
                  <% @manifest[:embedded_urls].first(80).each_with_index do |url, index| %>
                    <% if index < 20 %>
                      <li class="px-3 py-2 border-t font-mono text-xs leading-5 break-all text-gray-700 dark:text-gray-300"><%= url %></li>
                    <% else %>
                      <li class="px-3 py-2 border-t font-mono text-xs leading-5 break-all text-gray-700 dark:text-gray-300 hidden md:list-item"><%= url %></li>
                    <% end %>
                  <% end %>
                </ul>

                <% if @manifest[:embedded_urls].size > 20 %>
                  <div id="embedded-urls-pager" class="hidden items-center justify-center gap-3 mt-4">
                    <button id="prev-page" type="button"
                            class="invisible px-3 py-1 text-sm font-medium rounded border border-brand-600 text-brand-700 hover:bg-brand-50 dark:border-brand-300 dark:text-brand-200 dark:hover:bg-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
                      Previous
                    </button>
                    <span class="text-sm text-gray-600 dark:text-gray-400" aria-live="polite">
                      Page <span id="current-page">1</span> of <span id="total-pages">1</span>
                    </span>
                    <button id="next-page" type="button"
                            class="invisible px-3 py-1 text-sm font-medium rounded border border-brand-600 text-brand-700 hover:bg-brand-50 dark:border-brand-300 dark:text-brand-200 dark:hover:bg-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
                      Next
                    </button>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

      </div>
    </div>
  <% end %>
</div>
</div>